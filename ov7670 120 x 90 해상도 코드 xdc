## This file is for Cmod S7-25 Rev. B + ultrasonic/servo + OV7670

## 12 MHz System Clock
set_property -dict { PACKAGE_PIN M9    IOSTANDARD LVCMOS33 } [get_ports { clk }];
create_clock -add -name sys_clk_pin -period 83.33 -waveform {0 41.66} [get_ports { clk }];

## Push Buttons
set_property -dict { PACKAGE_PIN D2    IOSTANDARD LVCMOS33 } [get_ports { btn[0] }];
set_property -dict { PACKAGE_PIN D1    IOSTANDARD LVCMOS33 } [get_ports { btn[1] }];

## 4 LEDs
set_property -dict { PACKAGE_PIN E2    IOSTANDARD LVCMOS33 } [get_ports { led[0] }];
set_property -dict { PACKAGE_PIN K1    IOSTANDARD LVCMOS33 } [get_ports { led[1] }];
set_property -dict { PACKAGE_PIN J1    IOSTANDARD LVCMOS33 } [get_ports { led[2] }];
set_property -dict { PACKAGE_PIN E1    IOSTANDARD LVCMOS33 } [get_ports { led[3] }];

## Pmod Header JA - ultrasonic
set_property -dict { PACKAGE_PIN J2    IOSTANDARD LVCMOS33 } [get_ports { ja[0] }]; # JA1, ultrasonic TRIG
set_property -dict { PACKAGE_PIN H2    IOSTANDARD LVCMOS33 } [get_ports { ja[1] }]; # JA2, ultrasonic ECHO
set_property -dict { PACKAGE_PIN H4    IOSTANDARD LVCMOS33 } [get_ports { ja[2] }];
set_property -dict { PACKAGE_PIN F3    IOSTANDARD LVCMOS33 } [get_ports { ja[3] }];
set_property -dict { PACKAGE_PIN H3    IOSTANDARD LVCMOS33 } [get_ports { ja[4] }];
set_property -dict { PACKAGE_PIN H1    IOSTANDARD LVCMOS33 } [get_ports { ja[5] }];
set_property -dict { PACKAGE_PIN G1    IOSTANDARD LVCMOS33 } [get_ports { ja[6] }];
set_property -dict { PACKAGE_PIN F4    IOSTANDARD LVCMOS33 } [get_ports { ja[7] }];

## USB UART
set_property -dict { PACKAGE_PIN L12   IOSTANDARD LVCMOS33 } [get_ports { uart_tx }];

## Existing outputs
set_property -dict { PACKAGE_PIN L1    IOSTANDARD LVCMOS33 } [get_ports { pio1 }]; # buzzer
set_property -dict { PACKAGE_PIN M4    IOSTANDARD LVCMOS33 } [get_ports { pio2 }];
set_property -dict { PACKAGE_PIN M3    IOSTANDARD LVCMOS33 } [get_ports { pio3 }];
set_property -dict { PACKAGE_PIN N2    IOSTANDARD LVCMOS33 } [get_ports { pio4 }]; # servo/PWM
set_property -dict { PACKAGE_PIN M2    IOSTANDARD LVCMOS33 } [get_ports { pio5 }];
set_property -dict { PACKAGE_PIN P3    IOSTANDARD LVCMOS33 } [get_ports { pio6 }];

## OV7670 data bus on PIO16-PIO23
set_property -dict { PACKAGE_PIN P14   IOSTANDARD LVCMOS33 } [get_ports { cam_d[0] }]; # PIO16
set_property -dict { PACKAGE_PIN P15   IOSTANDARD LVCMOS33 } [get_ports { cam_d[1] }]; # PIO17
set_property -dict { PACKAGE_PIN N13   IOSTANDARD LVCMOS33 } [get_ports { cam_d[2] }]; # PIO18
set_property -dict { PACKAGE_PIN N15   IOSTANDARD LVCMOS33 } [get_ports { cam_d[3] }]; # PIO19
set_property -dict { PACKAGE_PIN N14   IOSTANDARD LVCMOS33 } [get_ports { cam_d[4] }]; # PIO20
set_property -dict { PACKAGE_PIN M15   IOSTANDARD LVCMOS33 } [get_ports { cam_d[5] }]; # PIO21
set_property -dict { PACKAGE_PIN M14   IOSTANDARD LVCMOS33 } [get_ports { cam_d[6] }]; # PIO22
set_property -dict { PACKAGE_PIN L15   IOSTANDARD LVCMOS33 } [get_ports { cam_d[7] }]; # PIO23

## OV7670 sync/control on PIO26-PIO31, PIO40-PIO41
set_property -dict { PACKAGE_PIN L14   IOSTANDARD LVCMOS33 } [get_ports { cam_pclk  }]; # PIO26
set_property -dict { PACKAGE_PIN K14   IOSTANDARD LVCMOS33 } [get_ports { cam_xclk  }]; # PIO27
set_property -dict { PACKAGE_PIN J15   IOSTANDARD LVCMOS33 } [get_ports { cam_href  }]; # PIO28
set_property -dict { PACKAGE_PIN L13   IOSTANDARD LVCMOS33 } [get_ports { cam_vsync }]; # PIO29
set_property -dict { PACKAGE_PIN M13   IOSTANDARD LVCMOS33 } [get_ports { cam_sioc  }]; # PIO30
set_property -dict { PACKAGE_PIN J11   IOSTANDARD LVCMOS33 } [get_ports { cam_siod  }]; # PIO31
set_property -dict { PACKAGE_PIN C5    IOSTANDARD LVCMOS33 } [get_ports { cam_reset }]; # PIO40
set_property -dict { PACKAGE_PIN A2    IOSTANDARD LVCMOS33 } [get_ports { cam_pwdn  }]; # PIO41

## Bitstream settings
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]
set_property BITSTREAM.CONFIG.CONFIGRATE 33 [current_design]
set_property CONFIG_MODE SPIx4 [current_design]
